<UserControl x:Class="CSharpLernen.CodeNotizenSeite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Foreground="{StaticResource TextHell}" PreviewKeyDown="Seite_Taste">
    <Grid Margin="28,22,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MaxWidth="280" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Akzent}" FontSize="24"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="Code-Notizen" FontSize="23.5" FontWeight="Bold" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,16,0">
            <Label x:Name="SucheLabel" DockPanel.Dock="Top" Content="Volltextsuche" Target="{Binding ElementName=Suche}" Foreground="{StaticResource TextMittel}" Padding="0,0,0,4" />
            <TextBox x:Name="Suche" DockPanel.Dock="Top" AutomationProperties.LabeledBy="{Binding ElementName=SucheLabel}"
                     ToolTip="Durchsucht Titel, Kommentare und Code" TextChanged="Suche_Geaendert" />
            <TextBlock x:Name="Trefferstatus" DockPanel.Dock="Top" Margin="0,6,0,12" Foreground="{StaticResource TextMittel}" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Neue Notiz" Style="{StaticResource RandKnopf}" Click="Neu_Click" Margin="0,0,6,4" />
                <Button Content="Editor übernehmen" Style="{StaticResource RandKnopf}" Click="Uebernehmen_Click"
                        ToolTip="Kopiert den aktuellen Code aus dem Haupteditor in eine neue Notiz" Margin="0,0,0,4" />
            </WrapPanel>
            <ListBox x:Name="Treffer" SelectionChanged="Treffer_Gewaehlt" AutomationProperties.Name="Gespeicherte Code-Notizen"
                     Background="{StaticResource CodeHintergrund}" BorderBrush="{StaticResource Rand}" Foreground="{StaticResource TextHell}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock Text="{Binding Titel}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Geaendert.LocalDateTime, StringFormat=g}" Foreground="{StaticResource TextMittel}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <Label x:Name="TitelLabel" Content="Titel" Target="{Binding ElementName=Titel}" Foreground="{StaticResource TextMittel}" Padding="0,0,0,4" />
                <TextBox x:Name="Titel" AutomationProperties.LabeledBy="{Binding ElementName=TitelLabel}"
                         MaxLength="120" TextChanged="Feld_Geaendert" />
                <Label x:Name="KommentarLabel" Content="Notizen / Kommentare" Target="{Binding ElementName=Kommentar}"
                       Foreground="{StaticResource TextMittel}" Padding="0" Margin="0,12,0,4" />
                <TextBox x:Name="Kommentar" AutomationProperties.LabeledBy="{Binding ElementName=KommentarLabel}" Height="88"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Feld_Geaendert" />
                <TextBlock Text="C#-Code" Foreground="{StaticResource TextMittel}" Margin="0,12,0,4" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="Meldung" Margin="0,8,0,8" Foreground="{StaticResource TextMittel}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="Speichern" Style="{StaticResource AkzentKnopf}" Click="Speichern_Click" ToolTip="Strg+S" Margin="0,0,8,4" />
                    <Button Content="In Haupteditor laden" Style="{StaticResource RandKnopf}" Click="InEditor_Click"
                            ToolTip="Ersetzt den aktuellen Code im Haupteditor. Rückgängig mit Strg+Z." Margin="0,0,8,4" />
                    <Button x:Name="LoeschenKnopf" Content="Löschen" Style="{StaticResource RandKnopf}" Click="Loeschen_Click" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
            <Border Background="{StaticResource CodeHintergrund}" BorderBrush="{StaticResource Rand}" BorderThickness="1">
                <ae:TextEditor x:Name="Code" AutomationProperties.Name="C#-Code" Margin="4" ShowLineNumbers="True"
                               FontFamily="{StaticResource CodeSchrift}" FontSize="13.5" Background="Transparent"
                               Foreground="{StaticResource TextHell}" LineNumbersForeground="#658571"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="Feld_Geaendert" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
