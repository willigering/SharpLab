<Application x:Class="CSharpLernen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Systemfarben überschreiben (z. B. graue Ecke zwischen zwei Scrollbalken) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3346B96C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ABDFBD" />

        <!-- Farben -->
        <Color x:Key="AkzentFarbe">#3FCB6E</Color>
        <SolidColorBrush x:Key="Hintergrund" Color="#0B0F0C" />
        <SolidColorBrush x:Key="Panel" Color="#D90F1511" />
        <SolidColorBrush x:Key="Karte" Color="#D9121914" />
        <SolidColorBrush x:Key="KarteHell" Color="#E6151D18" />
        <SolidColorBrush x:Key="KarteHover" Color="#E61B251E" />
        <SolidColorBrush x:Key="Rand" Color="#1F3A28" />
        <SolidColorBrush x:Key="RandHell" Color="#2E5239" />
        <SolidColorBrush x:Key="Akzent" Color="#3FCB6E" />
        <SolidColorBrush x:Key="AkzentDunkel" Color="#2A8A4C" />
        <SolidColorBrush x:Key="AkzentHintergrund" Color="#16291D" />
        <SolidColorBrush x:Key="TextHell" Color="#C9D6CC" />
        <SolidColorBrush x:Key="TextMittel" Color="#93A597" />
        <SolidColorBrush x:Key="TextGedimmt" Color="#64756A" />
        <SolidColorBrush x:Key="Gruen" Color="#4CC27A" />
        <SolidColorBrush x:Key="Rot" Color="#E07070" />
        <SolidColorBrush x:Key="Gelb" Color="#DDB25E" />
        <SolidColorBrush x:Key="CodeHintergrund" Color="#F00A0E0B" />
        <SolidColorBrush x:Key="InlineCode" Color="#1A271F" />
        <SolidColorBrush x:Key="AkzentVerlauf" Color="#3FCB6E" />
        <FontFamily x:Key="CodeSchrift">pack://application:,,,/Ressourcen/Schrift/#JetBrains Mono NL, Cascadia Mono, Consolas, Courier New</FontFamily>
        <!-- Schrift der ganzen Oberfläche: eingebettete JetBrains Mono (OFL), sonst Cascadia Mono / Consolas -->
        <FontFamily x:Key="UiSchrift">pack://application:,,,/Ressourcen/Schrift/#JetBrains Mono NL, Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>

        <DropShadowEffect x:Key="Leuchten" Color="#3FCB6E" BlurRadius="6" ShadowDepth="0" Opacity="0.12" />
        <DropShadowEffect x:Key="LeuchtenStark" Color="#3FCB6E" BlurRadius="8" ShadowDepth="0" Opacity="0.3" />

        <Style x:Key="KartenRahmen" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Karte}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rand}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiSchrift}" />
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#F20A0F0C" BorderBrush="{StaticResource RandHell}" BorderThickness="1" Padding="9,5" Margin="6" CornerRadius="0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbalken -->
        <Style x:Key="ScrollDaumen" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="0" Background="#2F4235" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollDaumen}" Margin="2" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollDaumen}" Margin="2" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Navigation links -->
        <Style x:Key="NavKnopf" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMittel}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="Transparent" Padding="12,7" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14.5" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#162019" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#192A1F" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="#355841" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Akzent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextHell}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reiter (Theorie / Übung / Quiz, Ausgabe / Fehler / Log) -->
        <Style x:Key="ReiterKnopf" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextGedimmt}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rahmen" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextHell}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Rahmen" Property="Background" Value="#142118" />
                                <Setter Property="Foreground" Value="{StaticResource Akzent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kleine Auswahl-Pillen (Aufgabe 1, 2, 3) -->
        <Style x:Key="PillenKnopf" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMittel}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="#151F18" Padding="14,6" BorderThickness="1" BorderBrush="{StaticResource Rand}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource RandHell}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource AkzentHintergrund}" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextHell}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiz-Antwort -->
        <Style x:Key="AntwortKnopf" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="BorderBrush" Value="{StaticResource Rand}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="#101712" Padding="12,9" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Kreis" Width="14" Height="14" Stroke="{StaticResource RandHell}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Rectangle x:Name="Punkt" Width="6" Height="6" Fill="{StaticResource Akzent}" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#162019" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Kreis" Property="Stroke" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Punkt" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Knöpfe -->
        <Style x:Key="AkzentKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1A10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="#3FCB6E" BorderBrush="#3FCB6E" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#55D680" />
                                <Setter TargetName="Rahmen" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#3FCB6E" BlurRadius="8" ShadowDepth="0" Opacity="0.35" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="#E4ECE6" />
                                <Setter TargetName="Rahmen" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#3FCB6E" BlurRadius="8" ShadowDepth="0" Opacity="0.35" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#33A95B" />
                                <Setter TargetName="Rahmen" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GefahrKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="#1E0909" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="#D86262" BorderBrush="#D86262" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#E37878" />
                                <Setter TargetName="Rahmen" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#D86262" BlurRadius="8" ShadowDepth="0" Opacity="0.35" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="#E4ECE6" />
                                <Setter TargetName="Rahmen" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#D86262" BlurRadius="8" ShadowDepth="0" Opacity="0.35" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#B94F4F" />
                                <Setter TargetName="Rahmen" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GeisterKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Akzent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="Transparent" BorderBrush="{StaticResource AkzentDunkel}" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#143FCB6E" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#263FCB6E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="#E4ECE6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RandKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#151F18" />
            <Setter Property="BorderBrush" Value="{StaticResource RandHell}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Rahmen" Property="Background" Value="#1B2A20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMittel}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontFamily="{TemplateBinding FontFamily}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#1B2A20" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Rand}" />
                                <Setter Property="Foreground" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Listeneintrag im Lernpfad -->
        <Style x:Key="LektionKnopf" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMittel}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" CornerRadius="0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="8,7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#162019" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CodeHintergrund}" />
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rand}" />
            <Setter Property="CaretBrush" Value="{StaticResource Akzent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Akzent}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Rahmen" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource RandHell}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Kasten" Width="18" Height="18" VerticalAlignment="Center" Background="#0B120D" BorderBrush="{StaticResource RandHell}" BorderThickness="1" CornerRadius="0">
                                <TextBlock x:Name="Haken" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#07130B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Kasten" Property="Background" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Akzent}" />
                                <Setter TargetName="Haken" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Kasten" Property="BorderBrush" Value="#ABDFBD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="0" Background="#1F2C23" />
                            <Border x:Name="PART_Indicator" CornerRadius="0" HorizontalAlignment="Left" Background="{StaticResource AkzentVerlauf}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Rahmen" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#203126" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#151F18" BorderBrush="#375742" BorderThickness="1" CornerRadius="0">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9DB1A4" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#121A15" BorderBrush="#375742" BorderThickness="1" CornerRadius="0" Padding="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderSpur" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Akzent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" Background="#16231A" BorderBrush="{StaticResource Rand}" BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderSpur}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" VerticalAlignment="Center" Background="{StaticResource AkzentVerlauf}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderSpur}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Griff">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="G" Width="12" Height="20" Background="{StaticResource Akzent}" BorderBrush="#ABDFBD" BorderThickness="0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="G" Property="BorderThickness" Value="1.5" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="G" Property="Background" Value="#76CB92" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kontextmenüs (z. B. Rechtsklick in Textfeldern) -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource UiSchrift}" />
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F70A0F0C" BorderBrush="{StaticResource RandHell}" BorderThickness="1" Padding="3" Margin="6" MinWidth="170">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextHell}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Rahmen" Background="Transparent" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource TextGedimmt}" Margin="24,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#2246B96C" />
                                <Setter Property="Foreground" Value="{StaticResource Akzent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{StaticResource Rand}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
